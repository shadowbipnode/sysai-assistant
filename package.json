{
  "name": "sysai-assistant",
  "version": "1.7.0-beta",
  "private": true,
  "author": {
    "name": "SysAI Team",
    "email": "support@sysai.com"
  },
  "homepage": "https://github.com/shadowbipnode/sysai-assistant",
  "description": "AI-powered operational infrastructure toolkit",
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --config electron-builder.json",
    "electron:build:deb": "vite build && electron-builder --linux deb --config electron-builder.json",
    "electron:build:rpm": "vite build && electron-builder --linux rpm --config electron-builder.json",
    "electron:build:appimage": "vite build && electron-builder --linux AppImage --config electron-builder.json",
    "electron:build:all": "vite build && electron-builder --linux deb rpm AppImage --config electron-builder.json",
    "electron:build:win": "vite build && electron-builder --win nsis zip --x64 --config electron-builder.json",
    "electron:build:win:nsis": "vite build && electron-builder --win nsis --x64 --config electron-builder.json --publish never",
    "electron:build:win:portable": "vite build && electron-builder --win portable --x64 --config electron-builder.json",
    "electron:build:win:dir": "vite build && electron-builder --win dir --x64 --config electron-builder.json",
    "postinstall": "electron-builder install-app-deps",
    "prepare:bin": "chmod +x bin/ssh-audit 2>/dev/null || true"
  },
  "dependencies": {
    "axios": "^1.15.2",
    "cors": "^2.8.6",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.4.0",
    "electron-builder": "^26.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.9",
    "wait-on": "^8.0.0"
  }
}
